{
  "name": "rekreo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "webpack serve --mode development",
    "dev": "node scripts/dev.mjs",
    "build": "webpack --mode production",
    "test": "node --test tests/*.test.mjs",
    "test:firestore": "node scripts/test-firestore.mjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build --nojekyll",
    "android:config": "node scripts/android-config.mjs",
    "android:sync": "npm run android:config && npm run build && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run android:sync && cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "firebase": "^12.0.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-react": "^7.26.0",
    "@capacitor/cli": "^8.6.0",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.2",
    "dotenv": "^16.6.1",
    "firebase-admin": "^13.10.0",
    "gh-pages": "^6.3.0",
    "html-webpack-plugin": "^5.6.3",
    "style-loader": "^4.0.0",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "engines": {
    "node": ">=22"
  }
}
