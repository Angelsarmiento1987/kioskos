# Configuración pública de la aplicación web Firebase (Configuración del proyecto > Tus apps).
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_USE_EMULATORS=false
# URL pública final para los QR impresos. Vacío: origen actual.
REACT_APP_PUBLIC_APP_URL=
# Completar cuando exista la ficha Android. No se simula una descarga.
REACT_APP_PLAY_STORE_URL=
# NUNCA agregar CLOUDINARY_API_SECRET ni credenciales Admin SDK a este archivo.

# Cloudinary: preset UNSIGNED con allowed_formats=webp y Return delete token activado.
# El límite de 102400 bytes lo controla la app.
REACT_APP_CLOUDINARY_CLOUD_NAME=
REACT_APP_CLOUDINARY_UPLOAD_PRESET=
